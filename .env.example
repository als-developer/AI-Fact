# TruthEngine Ultimate - Environment Variables
# Copy this file to .env.local or .env.production and fill in your values

# Environment
ENVIRONMENT=development
API_VERSION=v3

# Security (CHANGE THESE!)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long
ENCRYPTION_KEY=your-32-byte-encryption-key-here-123456789

# Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_ZONE_ID=your-zone-id

# API Keys (Get from respective services)
HUGGINGFACE_API_KEY=hf_your-token-here
TAVILY_API_KEY=tvly-your-key-here
COHERE_API_KEY=your-cohere-key
OPENAI_API_KEY=sk-your-key-here

# Lemon Squeezy (Payment Processing)
LEMON_SQUEEZY_API_KEY=ls_your-key-here
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret-here

# Redis (Upstash)
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token

# Email (Resend or SendGrid)
RESEND_API_KEY=re_your-key-here
SENDGRID_API_KEY=SG.your-key-here

# Monitoring (Sentry)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Rate Limits
RATE_LIMIT_DEFAULT=20
RATE_LIMIT_PREMIUM=100
RATE_LIMIT_BUSINESS=500

# CORS
CORS_ORIGINS=https://chat.openai.com,https://chatgpt.com,https://claude.ai,https://gemini.google.com,https://truthengine.ai

# Feature Flags
ENABLE_DEEPFAKE_DETECTION=true
ENABLE_COMPLIANCE_SHIELD=true
ENABLE_ACADEMIC_SEARCH=true
ENABLE_TEAM_MANAGEMENT=true
